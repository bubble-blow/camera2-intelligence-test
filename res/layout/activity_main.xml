<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp" >

    <EditText
        android:id="@+id/edit_camera_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/camera_id_hint" />

    <Switch
        android:id="@+id/switch_raw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_raw" />

    <Button
        android:id="@+id/button_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_preview" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" >

        <TextureView
            android:id="@+id/texture_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.camera2intelligence.FaceOverlayView
            android:id="@+id/face_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <TextView
        android:id="@+id/text_faces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/faces_label" />

</LinearLayout>
